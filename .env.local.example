# No environment variables are required — the site builds and runs
# without any of them. The contact form uses a public Formspree form ID
# (see pages/contact.tsx) and the contact email lives in content/site.ts.
#
# Optional: external URL of the résumé PDF. When unset, the site serves
# /documents/Kevin_Kwan_SWE_2026_Resume.pdf from public/documents.
# NEXT_PUBLIC_RESUME_LINK=https://example.com/resume.pdf
